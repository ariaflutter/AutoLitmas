{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Litmas AutoLitmas Schema",
  "description": "146 field sesuai struktur Contoh Fix.ods. Kolom 1-84 = data terstruktur, 85-146 = narasi paragraf.",
  "type": "object",
  "properties": {
    "1_Nama_Klien": { "type": "string", "description": "Nama lengkap narapidana beserta bin/als", "example": "Samsul Muarip bin Moh Sanusi" },
    "2_Status_Litmas": { "type": "string", "description": "Status pengerjaan", "enum": ["Sudah Terselesaikan","Sudah Terkirim","Sudah Terdownload","Sudah di Data","Pending Belum Terkerjakan"], "default": "Sudah Terselesaikan" },
    "3_Jenis_Litmas": { "type": "string", "description": "Jenis program reintegrasi", "enum": ["Cuti Bersyarat","Pembebasan Bersyarat","Asimilasi di Rumah","Pembimbingan","Permintaan Pemindahan Lembaga Pemasyarakatan"], "example": "Pembebasan Bersyarat" },
    "4_Tanggal_TPP": { "type": "string", "format": "date", "description": "Tanggal sidang Tim Pengamat Pemasyarakatan (YYYY-MM-DD ISO 8601)", "example": "2022-12-14" },
    "5_Nomor_Sidang_TPP": { "type": "string", "description": "Nomor sidang TPP", "example": "212/TPP/XII/2022" },
    "6_Tanggal_Surat_Pengantar_Laporan": { "type": "string", "format": "date", "description": "Tanggal surat pengantar laporan Litmas (YYYY-MM-DD (ISO 8601))" },
    "7_Perihal_Surat_Pengantar_Laporan_Litmas": { "type": "string", "description": "Perihal surat pengantar", "example": "Laporan Hasil Penelitian Kemasyarakatan Untuk Program Pembebasan Bersyarat atas nama ..." },
    "8_Peminta_Nama_Instansi": { "type": "string", "description": "Nama instansi peminta (biasanya Lembaga Pemasyarakatan)", "default": "Lembaga Pemasyarakatan" },
    "9_Peminta_Kelas_Instansi": { "type": "string", "description": "Kelas instansi peminta", "enum": ["Kelas I","Kelas IA","Kelas IB","Kelas IIA","Kelas IIB","Kelas II","Kelas III"], "example": "Kelas IIA" },
    "10_Peminta_Kota_Instansi": { "type": "string", "description": "Kota instansi peminta", "default": "Jember" },
    "11_Tanggal_Permintaan_Surat": { "type": "string", "format": "date", "description": "Tanggal surat permintaan dari Lapas (YYYY-MM-DD (ISO 8601))" },
    "12_Nomor_Permintaan_Surat": { "type": "string", "description": "Nomor surat permintaan dari Lapas" },
    "13_Peminta_Perihal_Surat": { "type": "string", "description": "Perihal surat permintaan dari Lapas" },
    "14_No_Surat_Tugas": { "type": "string", "description": "Nomor surat tugas PK" },
    "15_Tanggal_Surat_Tugas": { "type": "string", "format": "date", "description": "Tanggal surat tugas PK (YYYY-MM-DD (ISO 8601))" },
    "16_No_Register_Litmas": { "type": "string", "description": "Nomor register Litmas Bapas" },
    "17_No_Register_Lapas": { "type": "string", "description": "Nomor register Lapas" },
    "18_Tempat_Lahir": { "type": "string", "description": "Tempat lahir klien" },
    "19_Tanggal_Lahir": { "type": "string", "format": "date", "description": "Tanggal lahir klien (YYYY-MM-DD (ISO 8601))" },
    "20_Tanggal_Putusan": { "type": "string", "format": "date", "description": "Tanggal putusan pengadilan (YYYY-MM-DD (ISO 8601))" },
    "21_No_Putusan": { "type": "string", "description": "Nomor putusan pengadilan" },
    "22_Pidana": { "type": "string", "description": "Lama pidana + denda/subsider", "example": "2 Tahun 6 Bulan Pidana Penjara" },
    "23_Pertama_Ditahan": { "type": "string", "format": "date", "description": "Tanggal pertama ditahan (YYYY-MM-DD (ISO 8601))" },
    "24_Sepertiga": { "type": "string", "format": "date", "description": "Tanggal 1/3 masa pidana (YYYY-MM-DD (ISO 8601))" },
    "25_Setengah": { "type": "string", "format": "date", "description": "Tanggal 1/2 masa pidana (YYYY-MM-DD (ISO 8601))" },
    "26_Dua_Pertiga": { "type": "string", "format": "date", "description": "Tanggal 2/3 masa pidana (YYYY-MM-DD (ISO 8601))" },
    "27_Ekspirasi": { "type": "string", "format": "date", "description": "Tanggal ekspirasi masa pidana (YYYY-MM-DD (ISO 8601))" },
    "28_Usia": { "type": "integer", "description": "Usia klien saat Litmas dibuat" },
    "29_Perkara": { "type": "string", "description": "Jenis tindak pidana", "example": "Penggelapan" },
    "30_Pasal": { "type": "string", "description": "Pasal yang didakwakan", "example": "Pasal 372 KUHP" },
    "31_Alamat": { "type": "string", "description": "Alamat lengkap klien (dusun/RT/RW/desa/kec/kab)" },
    "32_Jenis_Kelamin": { "type": "string", "enum": ["Laki-Laki","Perempuan"] },
    "33_Agama": { "type": "string", "enum": ["Islam","Kristen","Katolik","Hindu","Buddha","Konghucu"] },
    "34_Suku": { "type": "string", "description": "Suku klien", "example": "Madura" },
    "35_Bangsa": { "type": "string", "default": "Indonesia" },
    "36_Warga_Negara": { "type": "string", "default": "WNI" },
    "37_Pendidikan_Terakhir": { "type": "string", "enum": ["Tidak Sekolah","Tidak Tamat SD","Tamat SD","SD Tamat","SMP atau Sederajat","SLTP","SMA atau Sederajat","SLUA","D1 atau Sederajat","D2 atau Sederajat","D3 atau Sederajat","S1 atau Sederajat","S2","S3"] },
    "38_Pekerjaan": { "type": "string", "description": "Pekerjaan klien" },
    "39_Status_Perkawinan": { "type": "string", "enum": ["Belum Kawin","Menikah","Cerai Hidup","Cerai Mati","Janda","Duda"] },
    "40_Ciri_Khusus": { "type": "string", "default": "Tidak Ada" },
    "41_Ayah_Nama": { "type": "string" },
    "42_Ayah_Tempat_Lahir": { "type": "string" },
    "43_Ayah_Tanggal_Lahir": { "type": "string", "format": "date" },
    "44_Ayah_Agama": { "type": "string" },
    "45_Ayah_Suku": { "type": "string" },
    "46_Ayah_Bangsa": { "type": "string" },
    "47_Ayah_Warga_Negara": { "type": "string" },
